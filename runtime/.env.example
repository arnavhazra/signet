# Local HITL runtime. Copy to .env and fill DATABASE_URL.
# Hiring-manager path: hosted Supabase Postgres (no Docker Desktop).
#
# Session-mode pooler (:5432) is what SQLAlchemy/Alembic expect (prepared statements).
# Username for the pooler is <role>.<project-ref>, e.g. postgres.abcdef or forge_runtime.abcdef.
# Direct db.<ref>.supabase.co:5432 is IPv6; use the pooler on IPv4-only networks.
# TLS: runtime/certs/supabase-root-2021.crt is the Supabase pooler root CA (verify-full).
# Example (replace ref / region / password — never commit the real URL):
# DATABASE_URL=postgresql+asyncpg://forge_runtime.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://forge_runtime.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Redis and NATS: optional. If localhost is unreachable, the API uses in-process
# MemoryCache / MemoryBus (same adapters as TESTING). Do not require Docker.
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=dev-jwt-secret-change-me
API_KEYS=demo-runtime-key
DEMO_MODE=1
# Leave empty unless an OTLP collector is running (Docker/kind appendix).
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
