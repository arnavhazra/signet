{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm --prefix web ci",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{runtime/app/**,runtime/certs/**}",
      "excludeFiles": "{runtime/tests/**,runtime/**/*.md,runtime/docker-compose.yml}"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/mcp/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/ready", "destination": "/api/index" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/workflows", "destination": "/api/index" },
    { "source": "/admin/workflows/:path*", "destination": "/api/index" },
    { "source": "/admin/seed", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/docs/:path*", "destination": "/api/index" },
    { "source": "/redoc", "destination": "/api/index" },
    { "source": "/sessions/:path*", "destination": "/index.html" },
    { "source": "/agent", "destination": "/index.html" },
    { "source": "/audit", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
