# Signet web client
# Copy to .env.local for local overrides (never commit secrets).

# Orchestrator base URL (no trailing slash). Baked in at Vite production build.
# Leave unset in `npm run dev` — Vite proxies /v1, /health, /ready, /admin/workflows
# to http://127.0.0.1:8000 so the browser never hits CORS.
# Local docker / kind port-forward: http://localhost:8000
# Do not use http://api:8000 here — that hostname is in-cluster only.
# VITE_API_URL=http://localhost:8000

# Optional override of the public interview-demo runtime key (default: demo-runtime-key).
# Production would inject this via env rather than the frontend constant.
# VITE_API_KEY=demo-runtime-key

# Optional override of the demo admin JWT. Default is signed with
# JWT_SECRET=dev-jwt-secret-change-me from runtime/.env.example.
# VITE_DEMO_ADMIN_JWT=
